# PostgreSQL Database Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Examples:
# Local PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wedding_invitation"
# Neon / Supabase / Railway / Render:
# DATABASE_URL="postgres://user:password@ep-sample-1234.us-east-2.aws.neon.tech/neondb?sslmode=require"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wedding_invitation"
