# PostgreSQL Database Connection URL (Optional - built-in fallback operates automatically if omitted)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
#
# Examples by platform:
# 1. Neon Serverless Postgres:
# DATABASE_URL="postgresql://user:password@ep-sample-1234.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# 2. Supabase:
# DATABASE_URL="postgresql://postgres:password@db.xxxxxx.supabase.co:5432/postgres?sslmode=require"
#
# 3. Vercel Postgres:
# POSTGRES_URL="postgres://default:password@ep-sample-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
#
# 4. Railway / Render / Self-Hosted:
# DATABASE_URL="postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway"
#
# 5. Local PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wedding_invitation"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wedding_invitation"
